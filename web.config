<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <!-- WebDAV intercepts PUT and DELETE requests before they reach Node, returning its own
             HTML/XML error response instead of proxying them. TCPP uses PUT/DELETE for its own
             REST API (e.g. updating and removing Customer Group mappings), so WebDAV must be
             turned off for this site. -->
        <modules>
            <remove name="WebDAVModule" />
        </modules>
        <handlers>
            <remove name="WebDAVModule" />
            <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
        </handlers>

        <httpPlatform processPath="C:\Program Files\nodejs\node.exe" arguments=".\node_modules\tsx\dist\cli.mjs server.ts" stdoutLogEnabled="true" stdoutLogFile=".\logs\stdout">
            <environmentVariables>
                <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />
				<environmentVariable name="NODE_ENV" value="production" />
            </environmentVariables>
        </httpPlatform>
    </system.webServer>
    <system.web>
        <authentication mode="Windows" />
    </system.web>
</configuration>